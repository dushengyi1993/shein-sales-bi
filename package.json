{
  "name": "shein-sales-bi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SHEIN sales BI, marketing operations, and controlled automation tooling",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:generated": "node scripts/generate_product_match_key_schema.mjs --check",
    "check:source": "node scripts/check_source_integrity.mjs",
    "owner-knowledge:scan": "node scripts/owner_knowledge_sync.mjs scan",
    "owner-knowledge:sync": "node scripts/owner_knowledge_sync.mjs sync",
    "owner-knowledge:status": "node scripts/owner_knowledge_sync.mjs status",
    "owner-knowledge:validate-distribution": "node scripts/validate_owner_knowledge_distribution.mjs",
    "partner-cli:version": "node scripts/bi_ops_cli.mjs version",
    "partner-cli:package": "powershell -ExecutionPolicy Bypass -File scripts/build_partner_bi_ops_cli_package.ps1",
    "test:deterministic": "node scripts/run_deterministic_tests.mjs",
    "test": "npm run check:generated && npm run check:source && npm run test:deterministic"
  },
  "dependencies": {
    "pg": "8.16.3"
  }
}
