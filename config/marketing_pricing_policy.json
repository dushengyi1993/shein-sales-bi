    "allowWhenMatchedEtOperationalSaleableAtOrBelow": 10,
    "finallyRestoreOriginalUsableInventory": true,
    "restoreUsesCurrentLockedAndUnavailableInventory": true,
    "postRestoreReadback": ["inventory", "activity_enrollment_status"],
    "failClosedConditions": [
