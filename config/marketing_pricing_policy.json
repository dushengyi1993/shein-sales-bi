    "groupScope": "global_standard_goods_sn",
    "metricFields": ["c7_eps_uv", "c7EpsUv", "c30_eps_uv", "c30EpsUv", "eps_uv", "epsUv"],
    "onShelfOnly": true,
    "marginDeltaPct": 5,
    "floorMarginPct": 15,
    "whenBaseAtOrBelowFloor": "keep_top_at_floor_raise_others_by_delta",
