{
  "schemaVersion": "daily-inventory-replenishment-policy/v1",
  "policyVersion": "2026-08-01.3",
  "timezone": "Asia/Shanghai",
  "triggerUsableInventoryAtOrBelow": 20,
  "targetUsableInventory": 100,
  "minimumEtSellableForVirtualTopUp": 21,
  "requireCurrentDayEtSnapshot": true,
  "eligibleShelfStatusCodes": ["1", "3"],
  "soldOutRequiresOtherStoreOnShelfWithStock": true,
  "requireExactlyOneSku": true,
  "maxOpenApiSnapshotAgeHours": 2,
  "maxBiSnapshotAgeHours": 4,
  "etAlerts": {
    "criticalDaysOfSupply": 7,
    "warningDaysOfSupply": 14,
    "lowQuantity": 20,
    "replenishmentDaysOfSupply": 90
  },
  "execution": {
    "mode": "manual_review",
    "perRunUserConfirmationRequired": true,
    "perRunPayloadHashRequired": true,
    "storeScope": "all_enabled_stores",
    "automaticExecution": {
      "enabled": false,
      "authorizationId": null,
      "allowedContext": null,
      "authorizedAt": null,
      "authorizedBy": null
    }
  }
}
