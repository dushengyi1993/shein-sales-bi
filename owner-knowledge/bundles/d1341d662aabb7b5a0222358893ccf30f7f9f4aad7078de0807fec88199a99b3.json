    {
      "activation": "active",
      "contentHash": "5a08296de7b70644df5e3624301e937402f0b359f65ec36eb6dbca4ae72cd788",
      "explicitDurable": true,
      "machinePolicy": null,
      "publishedAt": "2026-06-23T13:50:00.000Z",
      "risk": "medium",
      "ruleKey": "advisory.execution.marketing.price.product_identity.b798066e609c",
      "scope": [
        "project:shein-sales-bi"
      ],
      "tags": [
        "product_identity",
        "price",
        "marketing",
        "execution"
      ],
      "text": "用户明确纠正:后续每次填报普通营销活动,都必须以上一次用户确认并真实执行/等待执行的最终版 `selection-plan + price-overrides` 作为基准,继承用户备注、固定价、特殊利润率、低价例外、货号归并和小数微调",
      "version": 1,
      "versionId": "okr_b1ad29803979c9b62f2f_5a08296de7b70644df5e"
    },
