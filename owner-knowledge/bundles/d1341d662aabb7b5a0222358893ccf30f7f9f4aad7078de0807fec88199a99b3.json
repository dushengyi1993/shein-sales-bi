      "scope": [
        "project:shein-sales-bi"
      ],
      "tags": [
        "publish"
      ],
      "text": "不得重新从默认策略或新扫描草稿直接起算。",
      "version": 1,
      "versionId": "okr_21737870807c1ff4471a_3b058e00696a7ec8417f"
