      "tags": [],
      "text": "敏感字段扫描不得出现 `[REDACTED OPAQUE TOKEN]`。",
      "version": 1,
      "versionId": "okr_b125e9c5388abc5f3502_083cda048b36c8d6ebef"
    },
    {
      "activation": "active",
      "contentHash": "36a9db6798055a2fca911d162c067c15d39990199bca6aa361505c563ec21801",
      "explicitDurable": true,
