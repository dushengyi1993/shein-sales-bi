[Unit]
Description=SHEIN BI cloud HL OpenAPI reconciliation
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/root
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/cloud_openapi_hl_reconciliation.sh yesterday
