[Unit]
Description=Send daily SHEIN BI and marketing inspection digest to the operations group
Wants=network-online.target
After=network-online.target shein-bi-cloud-marketing-repair.service

[Service]
Type=oneshot
User=sheinops
Group=sheinops
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/home/sheinops
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
ExecStart=/usr/bin/node /opt/shein-bi/app/scripts/send_daily_ops_group_digest.mjs
TimeoutStartSec=180
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-/opt/shein-bi/app/outputs/reports -/opt/shein-bi/app/state/daily_ops_group_digest_sent -/home/sheinops/.lark-cli -/home/sheinops/.local/share/lark-cli
