[Unit]
Description=SHEIN BI cloud full RTV tracking verification
Wants=network-online.target docker.service
After=network-online.target docker.service systemd-tmpfiles-setup.service

[Service]
Type=oneshot
Slice=shein-host-heavy-bi.slice
User=sheinops
Group=sheinops
UMask=0077
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/home/sheinops
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=TZ=Asia/Shanghai
Environment=SHEIN_RTV_TRANSPORT=webapi
Environment=SHEIN_RTV_VERIFY_TIMEOUT_MS=1500000
Environment=SHEIN_RTV_LIMIT=80
Environment=SHEIN_RTV_CASE_LIMIT=8
TimeoutStartSec=7200
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
MemoryHigh=1000M
MemoryMax=1500M
OOMPolicy=stop
KillMode=control-group
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/run_host_heavy_job.sh --domain rtv-verify --class materializer --lock-wait-sec 120 --deadline-at 05:27 --defer-state /srv/shein-bi/runtime/host-scheduler/rtv-verify.latest.json -- /usr/bin/env bash /opt/shein-bi/app/scripts/run_pipeline_stage.sh --stage rtv-verify --business-date yesterday --message "RTV tracking verification completed" -- /usr/bin/env bash /opt/shein-bi/app/scripts/cloud_rtv_verify.sh
SuccessExitStatus=75
