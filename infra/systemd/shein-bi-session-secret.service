[Unit]
Description=Provision the shared SHEIN BI session signing secret
After=local-fs.target
Before=shein-bi-portal.service shein-bi-query.service

[Service]
Type=oneshot
User=sheinops
Group=sheinops
UMask=0077
WorkingDirectory=/opt/shein-bi/app
Environment=NODE_ENV=production
ExecStart=/usr/bin/node scripts/provision_bi_session_secret.mjs --file /data/shein-bi/state/bi_portal_session_secret.local
RemainAfterExit=yes
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
ReadOnlyPaths=/opt/shein-bi/app /data/shein-bi/outputs
ReadWritePaths=/data/shein-bi/state
InaccessiblePaths=/data/shein-bi/profiles /opt/shein-bi/app/profiles /srv/shein-bi/secrets
