[Unit]
Description=SHEIN BI read-only Lark sales Q&A bot
Wants=network-online.target
After=network-online.target shein-bi-portal.service

[Service]
Type=simple
User=sheinops
Group=sheinops
UMask=0027
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/home/sheinops
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=CODEX_HOME=/home/sheinops/.codex
Environment=SHEIN_QA_LLM_ENABLED=1
Environment=SHEIN_QA_LLM_TIMEOUT_MS=45000
Environment=SHEIN_QA_CODEX_GATEWAY_ENABLED=1
Environment=SHEIN_QA_CODEX_GATEWAY_TIMEOUT_MS=600000
Environment=SHEIN_QA_CODEX_MODEL=gpt-5.5
Environment=SHEIN_QA_CODEX_REASONING_EFFORT=xhigh
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/cloud_lark_sales_qa_bot.sh
Restart=always
RestartSec=10
MemoryHigh=512M
MemoryMax=900M
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
