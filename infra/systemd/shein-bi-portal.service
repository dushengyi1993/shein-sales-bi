[Unit]
Description=SHEIN BI Portal Node service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=sheinops
Group=sheinops
UMask=0027
WorkingDirectory=/opt/shein-bi/app
EnvironmentFile=/srv/shein-bi/secrets/portal-warehouse.env
Environment=NODE_ENV=production
Environment=CODEX_HOME=/home/sheinops/.codex
Environment=SHEIN_OWNER_KNOWLEDGE_PRINCIPAL=dushengyi
Environment=SHEIN_OWNER_KNOWLEDGE_GIT_REPO_DIR=/srv/shein-bi/owner-knowledge-repo
Environment=SHEIN_OWNER_KNOWLEDGE_GIT_BRANCH=owner-knowledge
Environment=SHEIN_OWNER_KNOWLEDGE_GIT_REMOTE=origin
Environment=SHEIN_OWNER_KNOWLEDGE_GIT_LOCK_FILE=/srv/shein-bi/runtime/owner-knowledge-git-publish.lock
Environment=SHEIN_OWNER_KNOWLEDGE_RECONCILE_MS=3600000
Environment=SHEIN_BI_OPS_CLI_MIN_VERSION=2026.07.12.1
Environment=SHEIN_BI_OPS_CLI_RECOMMENDED_VERSION=2026.07.12.1
Environment=SHEIN_LINK_OPS_STORE=postgres
Environment=SHEIN_WEBHOOK_REPOSITORY_ENABLED=1
Environment=SHEIN_WEBHOOK_TASK_RECONCILE_MS=5000
Environment=SHEIN_WEBHOOK_TASK_RECONCILE_BATCH=50
Environment=SHEIN_WAREHOUSE_PG_HOST=127.0.0.1
Environment=SHEIN_WAREHOUSE_PG_PORT=54329
Environment=SHEIN_WAREHOUSE_PG_DATABASE=shein_bi
Environment=SHEIN_WAREHOUSE_PG_USER=shein_link_ops
Environment=SHEIN_WAREHOUSE_PG_POOL_MAX=6
Environment=SHEIN_QA_CODEX_GATEWAY_ENABLED=1
Environment=SHEIN_QA_LLM_ENABLED=1
Environment=SHEIN_QA_LLM_TIMEOUT_MS=45000
Environment=SHEIN_QA_CODEX_GATEWAY_TIMEOUT_MS=45000
Environment=SHEIN_QA_CODEX_MODEL=gpt-5.6-terra
Environment=SHEIN_QA_CODEX_REASONING_EFFORT=low
Environment=SHEIN_BI_AGENT_MODEL_FAST=gpt-5.6-terra
Environment=SHEIN_BI_AGENT_REASONING_FAST=low
Environment=SHEIN_BI_AGENT_TIMEOUT_FAST_MS=45000
Environment=SHEIN_BI_AGENT_MODEL_INTENT=gpt-5.6-luna
Environment=SHEIN_BI_AGENT_REASONING_INTENT=low
Environment=SHEIN_BI_AGENT_TIMEOUT_INTENT_MS=20000
Environment=SHEIN_BI_AGENT_MODEL_BALANCED=gpt-5.6-terra
Environment=SHEIN_BI_AGENT_REASONING_BALANCED=medium
Environment=SHEIN_BI_AGENT_TIMEOUT_BALANCED_MS=90000
Environment=SHEIN_BI_AGENT_MODEL_DEEP=gpt-5.6-sol
Environment=SHEIN_BI_AGENT_REASONING_DEEP=high
Environment=SHEIN_BI_AGENT_TIMEOUT_DEEP_MS=300000
Environment=SHEIN_BI_AGENT_MODEL_OWNER=gpt-5.6-sol
Environment=SHEIN_BI_AGENT_REASONING_OWNER=high
Environment=SHEIN_BI_AGENT_TIMEOUT_OWNER_MS=600000
Environment=SHEIN_BI_AGENT_MODEL_FALLBACK=gpt-5.5
Environment=SHEIN_BI_AGENT_REASONING_FALLBACK=medium
Environment=SHEIN_BI_AGENT_MAX_CONCURRENT=2
Environment=SHEIN_BI_AGENT_MAX_CONCURRENT_PER_ACTOR=1
Environment=SHEIN_BI_AGENT_MAX_QUEUE=12
Environment=SHEIN_BI_AGENT_MAX_QUEUED_PER_ACTOR=3
Environment=SHEIN_BI_AGENT_QUEUE_TIMEOUT_MS=30000
Environment=SHEIN_BI_AGENT_RATE_LIMIT=12
Environment=SHEIN_BI_AGENT_RATE_WINDOW_MS=600000
Environment=SHEIN_BI_OPS_AGENT_MAX_QUESTION_CHARS=12000
Environment=SHEIN_BI_AGENT_ALLOW_DIRECT_LLM_FALLBACK=0
Environment=SHEIN_BI_INTENT_PLANNER_ENABLED=1
Environment=SHEIN_BI_JOB_WORKER_ENABLED=1
Environment=SHEIN_BI_JOB_POLL_MS=1500
Environment=SHEIN_BI_JOB_LEASE_MS=600000
ExecStart=/usr/bin/node scripts/serve_bi_portal.mjs --host 127.0.0.1 --port 8787 --state-file /srv/shein-bi/runtime/bi_action_state.json --link-ops-task-file /srv/shein-bi/runtime/bi_link_ops_tasks.json --link-ops-chat-file /srv/shein-bi/runtime/bi_link_ops_chats.json --link-ops-asset-dir /srv/shein-bi/runtime/bi_link_ops_assets --audit-file /srv/shein-bi/logs/bi_portal_action_audit.jsonl
Restart=always
RestartSec=5
MemoryHigh=1200M
MemoryMax=2200M
OOMPolicy=stop
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
