[Unit]
Description=SHEIN BI cloud intraday refresh
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=sheinops
Group=sheinops
UMask=0077
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/home/sheinops
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_SALES_TRANSPORT=webapi
Environment=SHEIN_DOCKER_USE_SUDO=1
Environment=SHEIN_BI_OPENAPI_RECON_DIR=/opt/shein-bi/app/outputs/reports/openapi-sales-reconciliation
Environment=SHEIN_BI_REFRESH_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-cloud-sales-refresh.lock
Environment=SHEIN_BI_PORTAL_REFRESH_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-portal-refresh.lock
Environment=SHEIN_BI_INVENTORY_COST_REFRESH=1
TimeoutStartSec=7200
MemoryHigh=1500M
MemoryMax=2500M
OOMPolicy=stop
KillMode=control-group
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/cloud_bi_refresh.sh today intraday
