[Unit]
Description=SHEIN BI retry a deferred daily guarded inventory replenishment
Wants=network-online.target
After=network-online.target shein-bi-daily-inventory-replenishment-guard.service

[Service]
Type=oneshot
Slice=shein-host-heavy-bi.slice
User=sheinops
Group=sheinops
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/home/sheinops
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_BI_INVENTORY_RUNTIME_ROOT=/srv/shein-bi/runtime/daily-inventory-replenishment
Environment=SHEIN_BI_PORTAL_URL=http://127.0.0.1:8787
Environment=SHEIN_BI_INVENTORY_LINKS_MAX_AGE_SECONDS=1800
Environment=SHEIN_BI_INVENTORY_LINKS_REFRESH_TIMEOUT_SECONDS=600
Environment=SHEIN_BI_INVENTORY_REFRESH_OPENAPI_ON_STALE=1
Environment=SHEIN_BI_INVENTORY_REQUIRE_PIPELINE_MARKERS=1
Environment=SHEIN_BI_INVENTORY_AUTOMATION_CONTEXT=cloud_daily_inventory_replenishment_guard
Environment=SHEIN_BI_INVENTORY_AUTOMATION_AUTHORIZATION=owner-automatic-inventory-20260803-v1
TimeoutStartSec=900
TimeoutStopSec=30
KillMode=control-group
Nice=12
CPUWeight=40
MemoryHigh=1000M
MemoryMax=1600M
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/run_cloud_inventory_guard_retry.sh
SuccessExitStatus=75

