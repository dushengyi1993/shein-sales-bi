[Unit]
Description=SHEIN BI cloud ET forwarder sync
Wants=network-online.target docker.service
After=network-online.target docker.service systemd-tmpfiles-setup.service

[Service]
Type=oneshot
Slice=shein-host-heavy-bi.slice
User=root
Group=sheinops
UMask=0027
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/root
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_ET_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-cloud-et-forwarder.lock
Environment=SHEIN_BI_PORTAL_REFRESH_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-portal-refresh.lock
Environment=SHEIN_PYTHON=/opt/shein-bi/app/.venv-et/bin/python
Environment=SHEIN_ET_LOG_DIR=/srv/shein-bi/logs/cloud-et-forwarder
Environment=SHEIN_ET_REFRESH_PORTAL_MODE=sections
Environment=SHEIN_ET_REFRESH_SECTIONS=orders,waybills,afterSales,inventoryTrend
Environment=SHEIN_BI_PORTAL_REFRESH_LOCK_WAIT_SEC=120
Environment=SHEIN_BI_PORTAL_PREWARM_ASYNC=0
Environment="SHEIN_ET_WAIT_SERVICES=shein-bi-cloud-today.service shein-bi-cloud-yesterday.service shein-bi-cloud-session-manager.service shein-bi-db-backup.service"
Environment="SHEIN_ET_SKIP_IF_SERVICES=shein-bi-cloud-daily-refresh.service shein-bi-cloud-morning-chain.service"
Environment=SHEIN_ET_WAIT_BUSY_TIMEOUT_SEC=2700
TimeoutStartSec=7200
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
MemoryHigh=800M
MemoryMax=1200M
OOMPolicy=stop
KillMode=control-group
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/run_host_browser_read_job.sh --domain et-forwarder --lock-wait-sec 120 --deadline-minute 29 --defer-state /srv/shein-bi/runtime/host-scheduler/et-forwarder.latest.json -- /usr/bin/env bash /opt/shein-bi/app/scripts/run_pipeline_stage.sh --stage et-forwarder --message "ET warehouse sync completed" -- /usr/bin/env bash /opt/shein-bi/app/scripts/cloud_et_forwarder_sync.sh today
SuccessExitStatus=75
