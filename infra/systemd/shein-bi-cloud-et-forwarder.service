[Unit]
Description=SHEIN BI cloud ET forwarder sync
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/root
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_BI_PORTAL_REFRESH_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-portal-refresh.lock
Environment=SHEIN_PYTHON=/opt/shein-bi/app/.venv-et/bin/python
Environment=SHEIN_ET_LOG_DIR=/srv/shein-bi/logs/cloud-et-forwarder
Environment=SHEIN_ET_REFRESH_PORTAL_MODE=sections
Environment=SHEIN_ET_REFRESH_SECTIONS=orders,waybills,afterSales,inventoryTrend
Environment=SHEIN_BI_PORTAL_REFRESH_LOCK_WAIT_SEC=120
Environment=SHEIN_BI_PORTAL_PREWARM_ASYNC=1
Environment="SHEIN_ET_WAIT_SERVICES=shein-bi-cloud-today.service shein-bi-cloud-yesterday.service shein-bi-cloud-session-manager.service shein-bi-db-backup.service"
Environment="SHEIN_ET_SKIP_IF_SERVICES=shein-bi-cloud-daily-refresh.service shein-bi-cloud-morning-chain.service"
Environment=SHEIN_ET_WAIT_BUSY_TIMEOUT_SEC=2700
TimeoutStartSec=7200
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
MemoryHigh=800M
MemoryMax=1200M
OOMPolicy=stop
KillMode=control-group
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/cloud_et_forwarder_sync.sh today
