[Unit]
Description=SHEIN BI cloud yesterday final refresh
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
User=sheinops
Group=sheinops
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/home/sheinops
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_SALES_TRANSPORT=webapi
Environment=SHEIN_DOCKER_USE_SUDO=1
Environment=SHEIN_BI_OPENAPI_RECON_DIR=/opt/shein-bi/app/outputs/reports/openapi-sales-reconciliation
TimeoutStartSec=10800
MemoryHigh=1500M
MemoryMax=2500M
OOMPolicy=stop
KillMode=control-group
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/cloud_bi_refresh.sh yesterday yesterday-final
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/cloud_bi_refresh.sh 2daysago third-day-stable-recheck
