[Unit]
Description=SHEIN BI conditional stock-only ET low-inventory recheck
Wants=network-online.target docker.service
After=network-online.target docker.service systemd-tmpfiles-setup.service

[Service]
Type=oneshot
Slice=shein-host-heavy-bi.slice
User=root
Group=sheinops
UMask=0027
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/root
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_OPENAPI_PRODUCT_CACHE_DIR=/srv/shein-bi/runtime/openapi-product-cache
Environment=SHEIN_BI_ET_LOW_INVENTORY_RUNTIME_ROOT=/srv/shein-bi/runtime/et-low-inventory-guard
Environment=SHEIN_ET_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-cloud-et-forwarder.lock
Environment=SHEIN_BI_PORTAL_REFRESH_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-portal-refresh.lock
Environment=SHEIN_PYTHON=/srv/shein-bi/runtime/et-forwarder/current/bin/python
Environment=SHEIN_ET_RUNTIME_ROOT=/srv/shein-bi/runtime/et-forwarder
Environment=SHEIN_ET_LOG_DIR=/srv/shein-bi/logs/cloud-et-forwarder
Environment=SHEIN_ET_TRANSPORT=http
Environment=SHEIN_ET_HTTP_SESSION_FILE=/srv/shein-bi/runtime/et-forwarder/session/et_forwarder_http_session.local.json
Environment=SHEIN_BI_INVENTORY_AUTOMATION_CONTEXT=cloud_et_low_inventory_guard
Environment=SHEIN_BI_INVENTORY_AUTOMATION_AUTHORIZATION=owner-automatic-et-low-inventory-20260806-v1
TimeoutStartSec=900
Nice=8
CPUWeight=45
MemoryHigh=800M
MemoryMax=1200M
OOMPolicy=stop
KillMode=control-group
ExecStartPre=+/usr/bin/env bash /opt/shein-bi/app/scripts/ensure_et_forwarder_runtime.sh
ExecStartPre=+/usr/bin/install -d -o sheinops -g sheinops -m 0750 /srv/shein-bi/runtime/openapi-product-cache
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/run_host_heavy_job.sh --domain et-low-inventory-recheck --class materializer --lock-wait-sec 60 --deadline-minute 27 --defer-state /srv/shein-bi/runtime/host-scheduler/et-low-inventory-recheck.latest.json -- /usr/bin/env bash /opt/shein-bi/app/scripts/cloud_et_low_inventory_recheck.sh
SuccessExitStatus=75
