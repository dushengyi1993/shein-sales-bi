[Unit]
Description=SHEIN BI cloud order lifecycle closure recheck
Wants=network-online.target docker.service shein-bi-portal.service
After=network-online.target docker.service shein-bi-portal.service systemd-tmpfiles-setup.service

[Service]
Type=oneshot
Slice=shein-host-heavy-bi.slice
User=root
Group=sheinops
UMask=0027
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/root
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_SALES_TRANSPORT=openapi
TimeoutStartSec=10800
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6
MemoryHigh=1000M
MemoryMax=1500M
OOMPolicy=stop
KillMode=control-group
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/run_host_heavy_job.sh --domain order-closure --class openapi --lock-wait-sec 120 --deadline-at 07:27 --defer-state /srv/shein-bi/runtime/host-scheduler/order-closure.latest.json -- /usr/bin/env bash /opt/shein-bi/app/scripts/run_pipeline_stage.sh --stage order-closure --business-date yesterday --message "order lifecycle closure completed" -- /usr/bin/env bash /opt/shein-bi/app/scripts/cloud_order_closure.sh
SuccessExitStatus=75
