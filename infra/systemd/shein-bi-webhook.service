[Unit]
Description=SHEIN OpenAPI Webhook receiver and asynchronous worker
Wants=network-online.target
After=network-online.target shein-bi-portal.service

[Service]
Type=simple
User=sheinops
Group=sheinops
UMask=0027
WorkingDirectory=/opt/shein-bi/app
EnvironmentFile=/srv/shein-bi/secrets/webhook-warehouse.env
Environment=NODE_ENV=production
Environment=HOME=/home/sheinops
Environment=PATH=/home/sheinops/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=CODEX_HOME=/home/sheinops/.codex
Environment=SHEIN_OPENAPI_CONFIG_FILE=/opt/shein-bi/app/config/shein_openapi.local.json
Environment=SHEIN_LINK_OPS_STORE=postgres
Environment=SHEIN_WAREHOUSE_PG_HOST=127.0.0.1
Environment=SHEIN_WAREHOUSE_PG_PORT=54329
Environment=SHEIN_WAREHOUSE_PG_DATABASE=shein_bi
Environment=SHEIN_WAREHOUSE_PG_USER=shein_webhook_ops
Environment=SHEIN_WAREHOUSE_PG_APPLICATION_NAME=shein_webhook
Environment=SHEIN_WAREHOUSE_PG_POOL_MAX=6
Environment=SHEIN_WEBHOOK_HOST=127.0.0.1
Environment=SHEIN_WEBHOOK_PORT=8792
Environment=SHEIN_WEBHOOK_WORKER_ENABLED=1
Environment=SHEIN_WEBHOOK_WORKER_POLL_MS=1000
Environment=SHEIN_WEBHOOK_WORKER_LEASE_MS=600000
Environment=SHEIN_WEBHOOK_WORKER_MAX_ATTEMPTS=8
Environment=SHEIN_WEBHOOK_MAX_BODY_BYTES=1048576
Environment=SHEIN_WEBHOOK_MAX_SKEW_MS=300000
Environment=SHEIN_WEBHOOK_INGRESS_BUDGET_MS=1200
Environment=SHEIN_WEBHOOK_RECEIPT_STATEMENT_TIMEOUT_MS=800
Environment=SHEIN_OPENAPI_REQUEST_TIMEOUT_MS=30000
Environment=SHEIN_SYNC_ISSUE_OUT_DIR=/srv/shein-bi/logs/webhook-alerts
ExecStart=/usr/bin/node scripts/serve_shein_webhook.mjs
Restart=always
RestartSec=5
TimeoutStopSec=30
MemoryHigh=600M
MemoryMax=1000M
OOMPolicy=stop
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
NoNewPrivileges=true
RestrictSUIDSGID=true
ReadWritePaths=-/srv/shein-bi/logs/webhook-alerts

[Install]
WantedBy=multi-user.target
