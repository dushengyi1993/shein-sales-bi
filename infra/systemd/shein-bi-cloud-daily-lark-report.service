[Unit]
Description=SHEIN BI cloud daily Lark report
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/root
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_LARK_REPORT_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-cloud-daily-lark-report.lock
Environment=SHEIN_FEISHU_BASE_PAUSED=1
Environment=SHEIN_LARK_REPORT_DISABLED=1
TimeoutStartSec=1800
Nice=10
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/cloud_daily_lark_report.sh today
