[Unit]
Description=SHEIN BI cloud morning chain: 08 sales -> optional Lark report -> daily refresh
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/root
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_BI_MORNING_SEND_LARK_REPORT=0
TimeoutStartSec=21600
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=60
MemoryHigh=2600M
MemoryMax=3400M
OOMPolicy=stop
KillMode=control-group
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/cloud_morning_chain.sh
