[Unit]
Description=SHEIN BI guarded local disk cache cleanup

[Service]
Type=oneshot
Slice=shein-host-heavy-bi.slice
User=root
Group=sheinops
UMask=0027
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/root
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_BI_BACKUP_OFFSITE_ENABLED=0
Environment=SHEIN_BI_OUTPUT_RETENTION_DAYS=30
Environment=SHEIN_BI_TMP_RETENTION_DAYS=7
Environment=SHEIN_BI_PROFILE_CACHE_THRESHOLD_PERCENT=75
Environment=SHEIN_BI_DISK_MAINTENANCE_LOG_DIR=/srv/shein-bi/logs/disk-maintenance
TimeoutStartSec=7200
Nice=15
IOSchedulingClass=idle
CPUWeight=20
MemoryHigh=512M
MemoryMax=1024M
OOMPolicy=stop
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/run_host_heavy_job.sh --domain disk-maintenance --class materializer --lock-wait-sec 60 --deadline-at 00:27 --defer-state /srv/shein-bi/runtime/host-scheduler/disk-maintenance.latest.json -- /usr/bin/env bash /opt/shein-bi/app/scripts/cloud_disk_maintenance.sh
SuccessExitStatus=75
