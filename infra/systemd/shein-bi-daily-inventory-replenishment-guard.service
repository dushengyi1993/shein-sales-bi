[Unit]
Description=SHEIN BI daily guarded inventory replenishment
Wants=network-online.target shein-bi-cloud-morning-chain.service
After=network-online.target shein-bi-cloud-morning-chain.service shein-bi-cloud-et-forwarder.service

[Service]
Type=oneshot
User=sheinops
Group=sheinops
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/home/sheinops
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_BI_INVENTORY_RUNTIME_ROOT=/srv/shein-bi/runtime/daily-inventory-replenishment
Environment=SHEIN_BI_PORTAL_URL=http://127.0.0.1:8787
Environment=SHEIN_BI_INVENTORY_LINKS_MAX_AGE_SECONDS=1800
Environment=SHEIN_BI_INVENTORY_LINKS_REFRESH_TIMEOUT_SECONDS=1200
Environment=SHEIN_BI_INVENTORY_REFRESH_OPENAPI_ON_STALE=1
Environment=SHEIN_BI_INVENTORY_AUTOMATION_CONTEXT=cloud_daily_inventory_replenishment_guard
Environment=SHEIN_BI_INVENTORY_AUTOMATION_AUTHORIZATION=owner-automatic-inventory-20260803-v1
TimeoutStartSec=3600
Nice=12
CPUWeight=40
MemoryHigh=1000M
MemoryMax=1600M
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/cloud_daily_inventory_replenishment_guard.sh
