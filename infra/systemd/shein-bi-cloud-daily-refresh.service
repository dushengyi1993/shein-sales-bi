[Unit]
Description=SHEIN BI cloud daily slow-changing data refresh
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
Slice=shein-host-heavy-bi.slice
User=sheinops
Group=sheinops
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/home/sheinops
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_OPENAPI_PRODUCT_CACHE_DIR=/srv/shein-bi/runtime/openapi-product-cache
Environment=SHEIN_BI_DAILY_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-cloud-daily-refresh.lock
Environment=SHEIN_LARK_REPORT_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-cloud-daily-lark-report.lock
Environment=SHEIN_BI_PORTAL_REFRESH_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-portal-refresh.lock
Environment=SHEIN_BI_DAILY_LOG_DIR=/srv/shein-bi/logs/cloud-daily-refresh
Environment=SHEIN_BI_DAILY_WAIT_BUSY_TIMEOUT_SEC=3600
Environment="SHEIN_BI_DAILY_WAIT_SERVICES=shein-bi-cloud-today.service shein-bi-cloud-yesterday.service shein-bi-cloud-et-forwarder.service shein-bi-cloud-session-manager.service shein-bi-db-backup.service"
Environment=SHEIN_BI_DAILY_MIN_AVAILABLE_MEM_MIB=2500
Environment=SHEIN_LINK_BUSINESS_STORE_ATTEMPTS=2
Environment=SHEIN_RTV_LIMIT=160
Environment=SHEIN_RTV_CASE_LIMIT=12
Environment=SHEIN_BI_DAILY_OPENAPI_RECONCILIATION=1
Environment=SHEIN_BI_DAILY_OPENAPI_RETURN_RECONCILIATION=1
Environment=SHEIN_BI_DAILY_OPENAPI_FINANCE_SYNC=1
Environment=SHEIN_OPENAPI_FINANCE_WINDOW_DAYS=35
Environment=SHEIN_OPENAPI_FINANCE_CONCURRENCY=3
Environment=SHEIN_BI_DAILY_OPENAPI_PRODUCT_RECONCILIATION=1
Environment=SHEIN_BI_DAILY_INVENTORY_COST_REFRESH=1
TimeoutStartSec=14400
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=50
MemoryHigh=2200M
MemoryMax=2800M
OOMPolicy=stop
KillMode=control-group
ExecStartPre=+/usr/bin/install -d -o sheinops -g sheinops -m 0750 /srv/shein-bi/runtime/openapi-product-cache
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/run_host_heavy_job.sh --domain daily-refresh --class browser --lock-wait-sec 120 --defer-state /srv/shein-bi/runtime/host-scheduler/daily-refresh.latest.json -- /usr/bin/env bash /opt/shein-bi/app/scripts/cloud_daily_refresh.sh yesterday
SuccessExitStatus=75
