[Unit]
Description=SHEIN BI bounded marketing repair worker
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Slice=shein-host-heavy-bi.slice
User=sheinops
Group=sheinops
WorkingDirectory=/opt/shein-bi/app
Environment=HOME=/home/sheinops
Environment=TZ=Asia/Shanghai
Environment=SHEIN_BI_ROOT=/opt/shein-bi/app
Environment=SHEIN_BI_MARKETING_ARTIFACT_PUBLICATION_LOCK_FILE=/opt/shein-bi/app/state/locks/shein-bi-cloud-marketing-artifact-publication.lock
Environment=SHEIN_BI_MARKETING_ARTIFACT_PUBLICATION_LOCK_WAIT_SEC=30
Environment=SHEIN_BI_MANUAL_LIMITED_DISCOUNT_REGISTRY=/srv/shein-bi/runtime/marketing_manual_limited_discount_overrides.json
Environment=SHEIN_BI_MARKETING_PLAN_REGISTRY_FILE=/srv/shein-bi/runtime/marketing-plans/current.json
Environment=SHEIN_BI_MARKETING_REPAIR_LOG_DIR=/srv/shein-bi/logs/cloud-marketing-repair
Environment=SHEIN_BI_MARKETING_REPAIR_MAX_GROUPS=32
Environment=SHEIN_BI_MARKETING_REPAIR_LEASE_TTL_SEC=3000
Environment=SHEIN_BI_MARKETING_REPAIR_LEASE_HEARTBEAT_INTERVAL_SEC=300
Environment=SHEIN_BI_MARKETING_IMMEDIATE_AUTHORIZATION_FILE=/srv/shein-bi/marketing-repair-immediate/authorization.json
Environment=SHEIN_BI_MARKETING_LIVE_SCAN_TIMEOUT_SEC=2400
Environment=SHEIN_BI_MARKETING_LIVE_SCAN_KILL_AFTER_SEC=60
Environment=SHEIN_BI_MARKETING_STACK_REVIEW_TIMEOUT_SEC=900
Environment=SHEIN_BI_MARKETING_STACK_REVIEW_KILL_AFTER_SEC=60
Environment=SHEIN_BI_MARKETING_TERMINAL_SNAPSHOT_SAFETY_MARGIN_SEC=180
Environment=SHEIN_BI_MARKETING_HOST_FINALIZATION_RESERVE_SEC=4500
Environment=SHEIN_BI_MARKETING_PRICE_SESSION_CONCURRENCY=3
Environment=SHEIN_BI_MARKETING_AUTOMATION_CONTEXT=cloud_timer
Environment=SHEIN_BI_MARKETING_REPAIR_EXECUTION_LOCATION=cloud
Environment=SHEIN_BI_MARKETING_CLOUD_FALLBACK_ENABLED=true
Environment=SHEIN_BI_MARKETING_CLOUD_PRIMARY_ENABLED=true
Environment=SHEIN_BI_MARKETING_REPAIR_RUN_BUDGET_SEC=3600
Environment=SHEIN_OPS_BUSINESS_DELIVERY_ENABLED=1
Environment=SHEIN_BI_MARKETING_REPAIR_MIN_START_BUDGET_SEC=900
Environment=SHEIN_BI_MARKETING_AUTOMATION_AUTHORIZATION=owner-standing-cloud-marketing-v1
TimeoutStartSec=26400
TimeoutStopSec=90
KillSignal=SIGTERM
Nice=12
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUWeight=40
MemoryHigh=2200M
MemoryMax=3000M
OOMPolicy=stop
KillMode=control-group
ExecStart=/usr/bin/env bash /opt/shein-bi/app/scripts/run_cloud_marketing_fallback_slot.sh
SuccessExitStatus=75
