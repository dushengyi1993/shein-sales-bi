{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

http://sa.dushengyi.cc {
	redir https://sa.dushengyi.cc{uri} permanent
}

# 443 is multiplexed by HAProxy so SSH can continue using the same public port.
# HAProxy forwards HTTPS traffic to this local Caddy listener.
https://sa.dushengyi.cc:10443 {
	encode zstd gzip
	header -Alt-Svc
	tls {
		protocols tls1.2 tls1.3
	}
	reverse_proxy 127.0.0.1:8080 {
		# HAProxy passes TLS through without accepting spoofable client-IP
		# headers. Caddy therefore records the immediate trusted proxy hop.
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto https
		header_up Host {host}
	}
}

# Dedicated direct HTTPS fallback for SHEIN callbacks. Caddy exposes only the
# exact method/path and official push-IP allowlist; the receiver still verifies
# the official SHEIN signature.
https://sa.dushengyi.cc:8443 {
	header -Alt-Svc
	tls {
		protocols tls1.2 tls1.3
	}

	@shein_webhook {
		method POST
		path /api/shein/webhook/v1/events
		remote_ip 120.24.77.228 8.129.229.113 8.129.226.74 8.129.9.82 8.129.7.84 47.106.180.122 120.79.71.235 47.112.201.95 47.112.17.164 47.106.77.136 8.138.164.6 8.134.140.235 8.219.56.57 8.219.138.159 47.244.123.114 8.210.12.12 52.34.71.36 44.229.47.182 52.40.22.133 34.208.2.54 52.37.43.177 100.20.197.247 52.21.82.95 44.218.161.133
	}
	handle @shein_webhook {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up Host {host}
		}
	}

	respond 404
}

# Keep the old IP HTTP entrance available during migration.
# Authentication is still enforced by the internal nginx hop.
http://43.165.167.135 {
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
