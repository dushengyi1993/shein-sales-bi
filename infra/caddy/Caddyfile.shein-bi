{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

http://sa.dushengyi.cc {
	redir https://sa.dushengyi.cc{uri} permanent
}

# 443 is multiplexed by HAProxy so SSH can continue using the same public port.
# HAProxy forwards HTTPS traffic to this local Caddy listener.
https://sa.dushengyi.cc:10443 {
	encode zstd gzip
	header -Alt-Svc
	tls {
		protocols tls1.2 tls1.3
	}
	reverse_proxy 127.0.0.1:8080 {
		# HAProxy rejects non-Cloudflare TLS peers for this SNI, so these
		# Cloudflare-owned headers are trusted for the original client IP.
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		header_up X-Forwarded-Proto https
		header_up Host {host}
	}
}

# Dedicated Cloudflare-supported HTTPS port for SHEIN callbacks. This avoids
# the 443 SSH/HTTPS TCP multiplexer, so Caddy can verify the immediate peer is
# a Cloudflare edge before trusting Cloudflare's original-client header.
https://sa.dushengyi.cc:8443 {
	header -Alt-Svc
	tls {
		protocols tls1.2 tls1.3
	}

	@shein_webhook {
		method POST
		path /api/shein/webhook/v1/events
		remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
	handle @shein_webhook {
		reverse_proxy 127.0.0.1:8080 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto https
			header_up Host {host}
		}
	}

	respond 404
}

# Keep the old IP HTTP entrance available during migration.
# Authentication is still enforced by the internal nginx hop.
http://43.165.167.135 {
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
