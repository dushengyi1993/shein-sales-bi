      },
      {
        "name": "info",
        "type": "object",
        "required": false,
        "description": "响应信息",
        "label": "QuerySkcRrpListOpenApiResp",
        "multiple": 0,
        "children": [
          {
            "name": "skc_rrp_list",
            "type": "object",
            "required": false,
            "description": "SKC列表",
            "multiple": 1,
            "children": [
              {
                "name": "skc_name",
                "type": "string",
                "required": false,
                "description": "SKC平台编码",
                "multiple": 0
              },
              {
                "name": "status",
                "type": "integer",
                "required": false,
                "description": "SKC的建议零售价状态。1-审核中 2-包含抽检失败 3-包含审核失败 4-生效中 5-即将过期 6-已过期失效 7-部分过期失效。其中2、3、7指的是SKC下的部分SKU有对应的状态，失败的部分代表没有建议零售价，具体是哪些SKU失败，可以查询审核记录：/open-api/goods-recommend-retail-price-audit/search",
                "multiple": 0
              },
              {
                "name": "status_desc",
                "type": "string",
                "required": false,
                "description": "当前状态的说明文案。例如status=1，desc=当前skc内有sku的建议零售价正在审核中，不能进行修改",
                "multiple": 0
              },
              {
                "name": "start_effective_time",
                "type": "int64",
                "required": false,
                "description": "SKC整体建议零售价的有效期开始时间(毫秒时间戳)",
                "multiple": 0
              },
              {
                "name": "end_effective_time",
                "type": "int64",
                "required": false,
                "description": "SKC整体建议零售价的有效期结束时间(毫秒时间戳)",
                "multiple": 0
              },
              {
                "name": "last_update_time",
                "type": "int64",
                "required": false,
                "description": "SKC整体建议零售价的最新更新时间(毫秒时间戳)",
                "multiple": 0
              },
              {
                "name": "sku_rrp_info_list",
                "type": "object",
                "required": false,
                "description": "SKC下详细的SKU建议零售价信息列表",
                "multiple": 1,
                "children": [
                  {
                    "name": "sku_code",
                    "type": "string",
                    "required": true,
                    "description": "SKU平台编码",
                    "example": "SKU001",
                    "multiple": 0
                  },
                  {
                    "name": "site_rrp_info_list",
                    "type": "object",
                    "required": false,
                    "description": "站点维度建议零售价列表。一个SKU可能有多组数据。如果A站点是按站点维度提供的，则site有值，例如shein-fr；如果BCD三个站点是不按站点维度提供的，则site无值。",
                    "multiple": 1,
                    "children": [
                      {
                        "name": "site",
                        "type": "string",
                        "required": false,
                        "description": "站点。若例如shein-fr。如果站点为空，则代表此组数据为不分站点的SKU维度建议零售价。",
                        "example": "us",
                        "multiple": 0
                      },
                      {
                        "name": "currency",
                        "type": "string",
                        "required": false,
                        "description": "币种。例如EUR",
                        "example": "USD",
                        "multiple": 0
                      },
                      {
                        "name": "suggested_retail_price",
                        "type": "string",
                        "required": false,
                        "description": "建议零售价",
                        "example": "19.99",
                        "multiple": 0
                      },
                      {
                        "name": "end_effective_time",
                        "type": "int64",
                        "required": false,
                        "description": "结束生效时间(毫秒时间戳)",
                        "example": "1741776000000",
                        "multiple": 0
                      },
                      {
                        "name": "start_effective_time",
                        "type": "int64",
                        "required": false,
                        "description": "开始生效时间(毫秒时间戳)。",
                        "example": "1739184000000",
                        "multiple": 0
                      },
                      {
