    "multiple": 0,
    "children": [
      {
        "name": "skc_name_list",
        "type": "string",
        "required": true,
        "description": "SKC平台编码列表，单次最多支持查询100个SKC。",
        "multiple": 1
      }
    ]
  },
  "responseBody": {
    "type": "object",
    "required": false,
    "description": "OK",
