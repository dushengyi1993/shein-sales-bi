{
  "docId": "3001304",
  "ok": true,
  "status": 200,
  "meta": {
    "title": "采购商库存更新(新)",
    "userDocName": "全托管/SHEIN自营商家库存更新",
    "endpoint": "/open-api/goods/stock-update",
    "method": "POST",
    "docName": "post_open-api_goods_stock-update",
    "version": 7,
    "updateTime": "2025-07-21 11:32:54",
    "changeContent": "更新请求示例",
    "qpsContent": "100",
    "modes": [
      2,
      3,
      8
    ],
    "modeNames": [
      "全托管",
      "SHEIN自营",
      "POP"
    ],
    "isSemiTrust": false
  },
  "description": "该API用于更新代运营（又称全托管、简易平台）和SHEIN自营商家的库存，接口支持全量方式更新；⚠️注意：自主运营和半托管模式应用请勿使用；",
  "requestHeader": {
    "type": "object",
    "children": [
      {
        "name": "Content-Type",
        "type": "string",
        "required": true,
        "defaultValue": "application/json"
      },
      {
        "name": "x-lt-openKeyId",
        "type": "string",
        "required": true,
        "description": "访问用户隐私数据时的唯一权限标识 openKeyId"
      },
      {
        "name": "x-lt-timestamp",
        "type": "string",
        "required": true,
        "description": "请求时间戳，格式为时间转换为毫秒的值，也就是从1970年1月1日起至今的时间转换为毫秒，如：1583398764000"
      },
      {
        "name": "x-lt-signature",
        "type": "string",
        "required": true,
        "description": "接口签名"
      }
    ]
  },
  "queryStrings": {
    "type": "object"
  },
  "requestBody": {
    "type": "object",
    "required": false,
    "multiple": 0,
    "children": [
      {
        "name": "stock",
        "type": "object",
        "required": true,
        "description": "库存出入库信息 单次记录数不超过200条",
        "multiple": 1,
        "children": [
          {
            "name": "skc",
            "type": "string",
            "required": true,
            "description": "SHEIN平台生成的SKC，相当于商品发布的skc_name",
            "multiple": 0
          },
          {
            "name": "shein_sku",
            "type": "string",
            "required": true,
            "description": "SHEIN平台生成的SKU，相当于商品发布的skucode",
            "multiple": 0
          },
          {
            "name": "remark",
            "type": "string",
            "required": false,
            "description": "备注 不超过100个字符",
            "multiple": 0
          },
          {
            "name": "available_number",
            "type": "string",
            "required": true,
            "description": "实际库存数量；"
          },
          {
            "name": "stock_type",
            "type": "string",
            "required": true,
            "description": "默认传3，全量覆盖"
          }
        ]
      }
    ]
  },
  "responseBody": {
    "type": "object",
    "children": [
      {
        "name": "code",
        "type": "integer",
        "example": "0",
        "multiple": 0
      },
      {
        "name": "msg",
        "type": "string",
        "example": "提交出入库成功",
        "multiple": 0
      },
      {
        "name": "traceId",
        "type": "string",
        "description": "请求的唯一标识；用于异常报错跟踪"
      },
      {
        "name": "info",
        "type": "object",
        "required": true,
        "multiple": 0,
        "children": [
          {
            "name": "batch_number",
            "type": "string",
            "description": "批次号 根据批次号查询时 可用到",
            "example": "201907170001",
            "multiple": 0
          },
          {
            "name": "fail_number",
            "type": "integer",
            "description": "失败数目"
          },
          {
            "name": "fail_list",
            "type": "object",
            "description": "失败明细数组",
            "multiple": 1,
            "children": [
              {
                "name": "stock_type",
                "type": "integer",
                "description": "3为全量同步库存"
              },
              {
                "name": "sku",
                "type": "string",
                "description": "商品sku与入参一致"
              },
              {
                "name": "skc",
                "type": "string",
                "description": "商品skc"
              },
              {
                "name": "shein_sku",
                "type": "string",
                "description": "shein 平台sku"
              },
              {
                "name": "attribute",
                "type": "string",
                "description": "属性集"
              },
              {
                "name": "access_number",
                "type": "integer",
                "description": "出入库数目"
              },
              {
                "name": "remark",
                "type": "string",
                "description": "出入库备注"
              },
              {
                "name": "fail_code",
                "type": "string",
                "description": "出入库错误码"
              },
              {
                "name": "fail_msg",
                "type": "string",
                "description": "出入库错误原因"
              }
            ]
          }
        ]
      }
    ]
  },
