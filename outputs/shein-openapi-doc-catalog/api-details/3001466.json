  "description": "该API支持自主运营，半托管商家导出收件人地址信息以及流转订单状态；对接前请查看解决方案：ERP订单履约方案；",
  "requestHeader": {
    "type": "object",
    "children": [
      {
        "name": "Content-Type",
        "type": "string",
        "required": true,
        "description": "application/json;charset=UTF-8"
      },
      {
        "name": "x-lt-openKeyId",
        "type": "string",
        "required": true,
        "description": "访问用户隐私数据时的唯一权限标识 openKeyId"
      },
      {
        "name": "x-lt-timestamp",
        "type": "string",
        "required": true,
        "description": "请求时间戳，格式为时间转换为毫秒的值，也就是从1970年1月1日起至今的时间转换为毫秒，如：1583398764000"
      },
      {
        "name": "x-lt-signature",
        "type": "string",
        "required": true,
        "description": "接口签名"
      }
    ]
  },
  "queryStrings": null,
  "requestBody": {
    "type": "object",
    "children": [
      {
        "name": "orderNo",
        "type": "string",
        "required": true,
        "description": "订单号",
        "multiple": 0
      },
      {
        "name": "handleType",
        "type": "integer",
        "required": true,
        "description": "操作类型；1：仅导出收件人地址信息/ 2：导出收件人地址并将订单状态流转到待发货，即订单状态值从 \"1\" 更改为 \"2\"",
        "example": "1",
        "multiple": 0
      }
    ]
  },
