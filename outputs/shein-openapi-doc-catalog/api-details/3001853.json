      }
    ]
  },
  "queryStrings": {
    "type": "object"
  },
  "requestBody": {
    "type": "object",
    "required": false,
    "description": "ERP保存证书池请求",
    "label": "ErpSaveCertificatePoolReq",
    "multiple": 0,
    "children": [
      {
        "name": "certificateDimension",
        "type": "integer",
        "required": false,
        "description": "证书适用范围：1-部分商品（即需要手动绑定至商品），2-全部商品（即自动和所有商品绑定）。创建时必填。",
        "multiple": 0
      },
      {
        "name": "certificateTypeCode",
        "type": "string",
        "required": false,
        "description": "证书类型编码。创建时必填，可通过/open-api/goods-compliance-requirements/list获取。",
        "multiple": 0
      },
      {
        "name": "fileList",
        "type": "object",
        "required": false,
        "description": "证书文件列表。所有文件必须转换为SHEIN链接后上传，不支持使用外部url。上传接口：/open-api/goods-certificate-files/upload",
        "multiple": 1,
        "children": [
          {
            "name": "fileMd5",
            "type": "string",
            "required": true,
            "description": "文件MD5。通过上传接口获取：/open-api/goods-certificate-files/upload",
            "multiple": 0
          },
          {
            "name": "fileName",
            "type": "string",
            "required": true,
            "description": "文件名称。ERP自定义名称。",
            "multiple": 0
          },
          {
            "name": "fileUrl",
            "type": "string",
            "required": true,
            "description": "文件URL。通过上传接口获取：/open-api/goods-certificate-files/upload",
            "multiple": 0
          }
        ]
      },
      {
        "name": "poolSn",
        "type": "string",
        "required": false,
        "description": "证书编号。创建时不用填写，编辑时必须填写。",
        "multiple": 0
      },
      {
        "name": "presetInfoList",
        "type": "object",
        "required": false,
        "description": "证书字段列表",
        "multiple": 1,
        "children": [
          {
            "name": "presetId",
            "type": "int64",
            "required": true,
            "description": "字段id。通过/open-api/goods-certificate-schemas/detail中获取。otherPresetInfoList和presetInfoList中的presetId都往此字段中传。",
            "multiple": 0
          },
          {
            "name": "valueList",
            "type": "object",
            "required": true,
            "description": "字段值列表。",
            "multiple": 1,
            "children": [
              {
                "name": "value",
                "type": "string",
                "required": false,
                "description": "字段值（手动输入版本）。不同字段场景填写方式不同：1、填写规则中presetInfoList下的字段，当inputType=3/4时，可在此入参手动输入的值。2、填写规则中otherPresetInfoList下的字段，区分以下两种情况：2.1 当sourceFrom=SRM，则需输入实验室id（srmDetectionAgencyList - laboratoryList - laboratoryId。注意实验室需要和valueId的机构是同一组数据）2.2 当sourceFrom≠SRM，则需输入字段自己的value值（otherPresetInfoList - presetValueList-presetValue）",
                "multiple": 0
              },
              {
                "name": "valueId",
                "type": "int64",
                "required": false,
                "description": "字段值（填写id版本）。不同字段场景填写方式不同：1、填写规则中presetInfoList下的字段，当inputType=1/2时，可在此录入id（presetInfoList - presetValueList - presetValueId）2、填写规则中otherPresetInfoList下的字段，区分以下两种情况：2.1 当sourceFrom=SRM，则需输入机构id（srmDetectionAgencyList - detectionAgency - detectionAgencyId。注意机构需要和value的实验室是同一组数据）2.2 当sourceFrom≠SRM，则需输入字段自己的value值（otherPresetInfoList - presetValueList-presetValueId）",
                "multiple": 0
              }
            ]
          }
        ]
      }
    ]
  },
