        "example": "OK",
        "multiple": 0
      },
      {
        "name": "info",
        "type": "object",
        "required": true,
        "description": "信息",
        "multiple": 0,
        "children": [
          {
            "name": "data",
            "type": "object",
            "required": true,
            "description": "规则详情",
            "multiple": 0,
            "children": [
              {
                "name": "is_rrp_required",
                "type": "integer",
                "description": "SKU维度建议零售价是否必填，0-非必填，1-必填",
                "example": "1",
                "multiple": 0
              },
              {
                "name": "site_filling_rule",
                "type": "integer",
                "description": "是否允许按分站点维度填写，1-允许，0-不允许",
                "example": "1",
                "multiple": 0
              },
              {
                "name": "available_sites",
                "type": "object",
                "required": true,
                "description": "分站点维度规则下，可填写的站点与币种列表。仅在site_filling_rule=1的时候，此字段才会有值。",
                "multiple": 1,
                "children": [
                  {
                    "name": "site",
                    "type": "string",
                    "description": "站点名，例如shein-fr",
                    "example": "shein-de",
                    "multiple": 0
                  },
                  {
                    "name": "currency",
                    "type": "string",
                    "description": "站点币种，例如EUR",
                    "example": "EUR",
                    "multiple": 0
                  },
                  {
                    "name": "material_requirement",
                    "type": "integer",
                    "description": "站点对辅助材料类型的要求，0-不需要填材料，1-类型一材料必填（文件必填，链接选填）、类型二材料选填（文件、链接均选填），2-类型一 或 类型二，至少填写一种（不论选哪一种类型，里面的文件、链接至少给一个）",
                    "example": "2",
                    "multiple": 0
                  }
                ]
              },
              {
                "name": "non_site_filling_rule",
                "type": "integer",
                "description": "不分站点填写规则，1-可填，0-不可填",
                "example": "1",
                "multiple": 0
              },
              {
                "name": "non_site_currencies",
                "type": "string",
                "description": "不分站点的规则下，可填写的币种列表。仅在non_site_filling_rule=1的时候，此字段才会有值。",
                "example": "USD",
                "multiple": 1
              }
            ]
          }
        ]
      },
      {
        "name": "traceId",
        "type": "string",
        "description": "追踪码",
        "example": "38d84125d30c03e0",
