  "responseExample": "code\": \"0\", \"msg\": \"OK\", \"info\": { \"shippingMethods\": [ { \"agedProductCode\": \"GEF\", \"agedProductName\": \"默认时效产品\", \"purchaseOrders\": [ \"B241217500033\", \"B241217500031\", \"B241217500032\" ], \"expressInfos\": [ { \"companyName\": \"顺丰\", \"companyCode\": \"shunfeng\", \"isSupport\": true, \"isRecommend\": false }, { \"companyName\": \"车门\", \"companyCode\": \"chemen\", \"isSupport\": true, \"isRecommend\": true }, { \"companyName\": \"跨越\", \"companyCode\": \"kuayue\", \"isSupport\": true, \"isRecommend\": false }, { \"companyName\": \"Anjun\", \"companyCode\": \"TMS-anjun\", \"isSupport\": true, \"isRecommend\": false } ] } ] }, \"bbl\": null, \"traceId\": \"7caca8b96ad583a3\" }",
