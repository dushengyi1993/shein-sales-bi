    "children": [
      {
        "name": "orderNo",
        "type": "string",
        "description": "订单号(平台指定物流的场景下，入参订单+包裹号获取面单)",
        "example": "nam ex culpa repudiandae rerum nam aut fuga at",
        "multiple": 0
      },
      {
        "name": "packageNo",
        "type": "string",
        "description": "包裹号(平台指定物流的场景下，入参订单+包裹号获取面单)",
        "example": "hic excepturi ut voluptatibus dicta accusamus qui architecto eius odit aut porro ullam optio voluptatibus sed enim asperiores est voluptatem",
        "multiple": 1
      },
      {
        "name": "deliveryNo",
        "type": "string",
        "description": "运单包裹号(在线下单的场景下，入参该字段打印面单)；从请求订单详情接口获取；"
      }
    ]
  },
  "responseBody": {
    "type": "object",
    "children": [
      {
        "name": "code",
