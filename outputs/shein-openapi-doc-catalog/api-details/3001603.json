            "multiple": 0
          }
        ]
      }
    ]
  },
  "requestExample": "curl --location --request POST 'https://openapi.sheincorp.com/open-api/order/print-express-info' \\ --header 'x-lt-signature: <OFFICIAL_EXAMPLE_SIGNATURE>' \\ --header 'x-lt-openKeyId: <OFFICIAL_EXAMPLE_OPEN_KEY_ID>' \\ --header 'Content-Type: application/json;charset=UTF-8' \\ --header 'x-lt-timestamp: 1752570849017' \\ --data-raw '{ \"orderNo\": \"GSONAM44T00NWYG\", \"packageNo\": [ \"GC23111521875392514\" ] }'",
