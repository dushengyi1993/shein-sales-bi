      },
      {
        "name": "msg",
        "type": "string",
        "description": "错误描述信息",
        "example": "OK",
        "multiple": 0
      },
      {
        "name": "traceId",
        "type": "string",
        "description": "请求的唯一标识；用于异常报错跟踪"
      },
      {
        "name": "info",
        "type": "object",
        "required": true,
        "description": "响应数据",
