      {
        "name": "code",
        "type": "string",
        "description": "响应码",
        "example": "40908",
        "multiple": 0
      },
      {
        "name": "info",
        "type": "object",
        "required": true,
        "description": "响应详情",
        "multiple": 0,
        "children": [
          {
            "name": "count",
            "type": "integer",
            "description": "查询结果条数",
            "example": "26842",
            "multiple": 0
          },
          {
            "name": "data",
            "type": "object",
