  "description": "支持获取商品成本价的议价单列表。目前仅支持3种议价类型：新品议价、老品议价、新品核价复议",
  "requestHeader": {
    "type": "object",
    "children": [
      {
        "name": "Content-Type",
        "type": "string",
        "required": true,
        "description": "application/json"
      },
      {
        "name": "x-lt-openKeyId",
        "type": "string",
        "required": true,
        "description": "访问用户隐私数据时的唯一权限标识 openKeyId"
      },
      {
        "name": "x-lt-signature",
        "type": "string",
        "required": true,
        "description": "请求签名"
      },
      {
        "name": "x-lt-timestamp",
        "type": "string",
        "required": true,
        "description": "请求时间戳，格式为时间转换为毫秒的值，也就是从1970年1月1日起至今的时间转换为毫秒，如：158339876400"
      },
      {
        "name": "language",
        "type": "string",
        "required": true,
        "description": "语种。默认为中文。支持语种:英语:US 法语:FR 西班牙语:ES 德语:DE 中文简体:CN 泰语:TH 巴西葡语:PT 土耳其语：TR"
      }
    ]
  },
  "queryStrings": null,
  "requestBody": {
    "type": "object",
    "children": [
      {
        "name": "discussStatus",
        "type": "integer",
        "description": "议价单状态,。1:待商家确认 2:待平台审核 3:接受议价 4:不接受议价 5:议价终止-成功 6:议价终止-失败",
        "multiple": 0
      },
      {
        "name": "pageNum",
        "type": "integer",
        "required": true,
        "description": "分页数量。建议从1开始查询",
        "example": "10",
        "multiple": 0
      },
      {
        "name": "pageSize",
        "type": "integer",
        "required": true,
        "description": "分页内条数，单页最多200",
        "example": "1",
        "multiple": 0
      }
    ]
  },
  "responseBody": {
    "type": "object",
