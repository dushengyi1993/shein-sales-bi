        "name": "spuNameList",
        "type": "string",
        "required": false,
        "description": "SPU编码列表（平台编码），单次最多10个。",
        "multiple": 1
      },
      {
        "name": "skcNameList",
        "type": "string",
        "required": false,
        "description": "SKC编码列表（平台编码），单次最多10个。",
        "multiple": 1
      },
      {
        "name": "skuCodeList",
        "type": "string",
        "required": false,
        "description": "SKU编码列表（平台编码），单次最多10个。",
        "multiple": 1
      },
      {
        "name": "skcSupplierCodeList",
        "type": "string",
        "required": false,
        "description": "SKC货号列表（商家维护的货号），单次最多10个。",
        "multiple": 1
      },
      {
        "name": "supplierSkuList",
        "type": "string",
        "required": false,
        "description": "商家SKU列表（商家维护的SKU货号），单次最多10个",
        "multiple": 1
      },
      {
        "name": "skcShelfStatus",
        "type": "integer",
        "required": false,
        "description": "SKC上架状态，0:下架 1:上架。待上架和已售罄均属于下架状态。",
        "example": "1",
        "multiple": 0
      },
      {
        "name": "languageList",
        "type": "string",
        "required": false,
        "description": "语种列表，决定商品信息中名称、属性名称、属性值名称返回的语种内容。单次最多入参5个语种，不传时默认返回英语。支持的语种包括：英语:en、法语:fr、西班牙语:es、德语:de、中文简体:zh-cn、泰语:th、巴西葡语:pt-br、日语:ja、韩语:ko",
        "multiple": 1
      },
      {
        "name": "createTimeStart",
        "type": "string",
        "required": false,
        "description": "SPU的发布时间段（开始时间），格式 yyyy-MM-dd HH:mm:ss。发布时间定义：SPU首次审核通过时间。",
        "example": "2024-01-01 00:00:00",
        "multiple": 0
      },
      {
        "name": "createTimeEnd",
        "type": "string",
        "required": false,
        "description": "SPU的发布时间段（结束时间），格式 yyyy-MM-dd HH:mm:ss。发布时间定义：SPU首次审核通过时间。",
        "example": "2024-12-31 23:59:59",
        "multiple": 0
      },
      {
        "name": "updateTimeEnd",
        "type": "string",
        "required": false,
        "description": "SPU的更新时间段（结束时间），格式 yyyy-MM-dd HH:mm:ss。更新时间定义：SPU下任意SKC的标题、品牌、IP、属性变更导致的更新。不包括价格、库存的更新。",
        "example": "2024-12-31 23:59:59",
        "multiple": 0
      },
      {
        "name": "updateTimeStart",
        "type": "string",
        "required": false,
        "description": "SPU的更新时间段（开始时间），格式 yyyy-MM-dd HH:mm:ss。更新时间定义：SPU下任意SKC的标题、品牌、IP、属性变更导致的更新。不包括价格、库存的更新。",
        "example": "2024-01-01 00:00:00",
        "multiple": 0
      }
    ]
  },
