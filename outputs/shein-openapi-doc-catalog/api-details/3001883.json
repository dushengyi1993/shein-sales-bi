        "type": "object",
        "required": false,
        "description": "商品价格信息列表, 最大长度100",
        "multiple": 1,
        "children": [
          {
            "name": "productCode",
            "type": "string",
            "required": true,
            "description": "传sku_code，sku_code是商品发布SHEIN生成的系统编码",
            "multiple": 0
          },
          {
            "name": "currencyCode",
            "type": "string",
            "required": true,
            "description": "币种，商品在SHEIN平台使用的售卖币种，如BRL, THB, USD, MXN. 具体币种可查询店铺站点和币种信息（新）获取",
            "multiple": 0
          },
          {
            "name": "shopPrice",
            "type": "double",
            "required": true,
            "description": "原价",
            "multiple": 0
          },
          {
            "name": "specialPrice",
            "type": "double",
            "required": false,
            "description": "特价 ，注：特价不传时，默认特价更新为0！",
            "multiple": 0
          },
          {
            "name": "site",
            "type": "string",
            "required": true,
            "description": "站点-只能传子站点。例如shein-us",
            "multiple": 0
          },
          {
            "name": "riseReason",
            "type": "string",
            "description": "涨价原因。枚举:1-商品成本上涨,2-物流履约费用上涨,3-活动结束恢复价格,4-其他,5-物流履约费用上涨（物流规则调整）"
          }
        ]
      }
    ]
  },
