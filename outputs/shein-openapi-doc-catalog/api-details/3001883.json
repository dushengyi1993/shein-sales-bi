  "requestExample": "curl --location --request POST 'https://openapi-test01.sheincorp.cn/open-api/openapi-business-backend/product/price/save' \\ --header 'language: zh-cn' \\ --header 'x-lt-openKeyId: <OFFICIAL_EXAMPLE_OPEN_KEY_ID>' \\ --header 'x-lt-signature: <OFFICIAL_EXAMPLE_SIGNATURE>' \\ --header 'x-lt-timestamp: 1752734980846' \\ --header 'Content-Type: application/json' \\ --header 'Host: openapi-test01.sheincorp.cn' \\ --data-raw '{ \"productPriceList\": [{ \"currencyCode\": \"MXN\", \"productCode\": \"I11mesukkwwr\", \"site\": \"shein-mx\", \"shopPrice\": 1, \"riseReason\":null, \"specialPrice\":null }] }'",
