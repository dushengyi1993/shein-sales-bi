  },
  "requestBody": {
    "type": "object",
    "required": false,
    "multiple": 0,
    "children": [
      {
        "name": "url",
        "type": "string",
        "description": "图片url。可使用外部图片地址，仅支持格式JPG/JPEG/PNG，大小≤3MB。url、productInfo，必须入参其中一个值，也可两个都入参。",
        "multiple": 0
      },
      {
        "name": "productInfo",
        "type": "string",
        "description": "商品的文案信息。可输入商品描述或商品名称等任意和商品相关的文本信息，不限语种，1000个字符内，不支持emoji。url、productInfo，必须入参其中一个值，也可两个都入参。"
      }
    ]
  },
