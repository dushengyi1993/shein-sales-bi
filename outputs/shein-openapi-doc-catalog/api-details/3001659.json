  "description": "该接口已逐步废弃，推荐优先对接【发货单维度打印面单接口】",
  "requestHeader": {
    "type": "object",
    "children": [
      {
        "name": "Content-Type",
        "type": "string",
        "required": true,
        "defaultValue": "application/json"
      },
      {
        "name": "x-lt-openKeyId",
        "type": "string",
        "required": true,
        "description": "访问用户隐私数据时的唯一权限标识 openKeyId"
      },
      {
        "name": "x-lt-timestamp",
        "type": "string",
        "required": true,
        "description": "请求时间戳，格式为时间转换为毫秒的值，也就是从1970年1月1日起至今的时间转换为毫秒，如：1583398764000"
      },
      {
        "name": "x-lt-signature",
        "type": "string",
        "required": true,
        "description": "接口签名"
      }
    ]
  },
  "queryStrings": null,
  "requestBody": {
    "type": "object",
    "children": [
      {
        "name": "orderNo",
        "type": "string",
        "required": true,
        "description": "发货单其中一个订单号",
        "defaultValue": "B22388923",
        "label": "订单号"
      }
    ]
  },
  "responseBody": {
    "type": "object",
    "children": [
      {
        "name": "code",
        "type": "string",
        "required": true,
        "description": "0成功，1失败",
        "label": "返回码"
      },
      {
        "name": "msg",
        "type": "string",
        "required": true,
        "label": "错误信息"
      },
      {
        "name": "info",
        "type": "object",
        "required": true,
        "children": [
          {
            "name": "orderNoList",
            "type": "string",
            "required": true,
            "description": "同个发货单的订单列表,如订单A,B一起发货,入参订单A查询,此字段会显示订单A,B",
            "label": "订单号列表",
            "multiple": 1
          },
          {
            "name": "packingType",
            "type": "string",
            "required": true,
            "description": "如果是包裹方式发货,pdf为包裹单. 如为箱唛发货,pdf为箱唛单",
            "label": "发货类型,1:包裹, 2:箱唛"
          },
          {
            "name": "url",
            "type": "string",
            "required": true,
            "description": "面单url",
            "label": "打印内容PDF下载链接"
          }
        ]
      },
      {
        "name": "traceId",
        "type": "string",
        "description": "请求的唯一标识；用于异常报错跟踪"
      }
    ]
  },
